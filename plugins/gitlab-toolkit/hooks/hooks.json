{
  "description": "GitLab Toolkit hooks for auto-detection and workflow automation",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-gitlab.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
